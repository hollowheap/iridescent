#!/usr/bin/env bash
set -euo pipefail
SELF_DIR="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -f "$SELF_DIR/../../../scripts/iridescent-artifacts" ]; then
  exec python3 "$SELF_DIR/../../../scripts/iridescent-artifacts" "$@"
elif [ -f "$PWD/scripts/iridescent-artifacts" ]; then
  exec python3 "$PWD/scripts/iridescent-artifacts" "$@"
elif command -v iridescent-artifacts >/dev/null 2>&1; then
  exec iridescent-artifacts "$@"
else
  echo "Error: iridescent-artifacts not found. Install iridescent-artifacts (for example via Nix flake) or place scripts/iridescent-artifacts in the workspace." >&2
  exit 1
fi
